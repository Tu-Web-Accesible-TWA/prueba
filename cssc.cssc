// ============================================================
// CETELEM - Estilos comunes de contenido
// Páginas: /accesibilidad, /seguridad, /landings/conoce-la-normativa-psd2, /informacion-legal
// ============================================================

// ----------------------------
// Variables
// ----------------------------
$color-green-primary:    #3a913f;
$color-green-link:       #337f37;
$color-green-link-hover: #2e7232;
$color-text-muted:       #4b4f54;

// ----------------------------
// Headings
// ----------------------------
h2 {
  color: $color-green-primary;
  padding-left: 0;
  padding-bottom: 0;
}

h3 {
  color: $color-green-primary;
}

h4 {
  color: $color-green-primary;
}

// ----------------------------
// Párrafos
// ----------------------------
p {
  margin-bottom: 10px;
  line-height: 1.6;
}

// ----------------------------
// Links
// ----------------------------
a {
  color: $color-green-link;
  font-weight: 500;
  text-decoration: underline;
  transition: color 300ms ease-out;

  &:hover {
    color: $color-green-link-hover;
    text-decoration: underline;
  }
}

// ----------------------------
// Listas no ordenadas (ul)
// ----------------------------
ul {
  margin-top: 10px;
  margin-bottom: 10px;
  margin-left: 20px;
  list-style-type: disc;

  li {
    margin-bottom: 4px;
    line-height: 1.5;
  }

  // Listas anidadas
  ul {
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 20px;
    list-style-type: circle;
  }
}

// ----------------------------
// Listas ordenadas (ol)
// ----------------------------
ol {
  margin-top: 10px;
  margin-bottom: 10px;
  margin-left: 0;
  padding-left: 20px;
  list-style-type: decimal;

  li {
    margin-bottom: 6px;
    line-height: 1.5;
  }
}

// ----------------------------
// strong / bold
// ----------------------------
strong {
  font-weight: 700;
}

// ----------------------------
// Tablas (usadas en /informacion-legal para formulario de desistimiento)
// ----------------------------
table {
  border: 2px solid $color-text-muted;
  padding: 15px;
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 16px;

  td {
    padding: 8px 15px;
    border: 1px solid lighten($color-text-muted, 30%);
    line-height: 1.5;

    &[style*="text-align:center"] {
      text-align: center;
    }

    &[style*="text-align:left"] {
      text-align: left;
    }
  }
}

// ----------------------------
// Details / Summary (accordion en /informacion-legal)
// ----------------------------
details {
  border-bottom: 1px solid #e0e0e0;
  margin-bottom: 4px;

  summary {
    cursor: pointer;
    padding: 16px 0;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &::marker {
      display: none;
    }

    p {
      margin: 0;
      font-weight: 600;
      color: $color-green-primary;
      font-size: 1rem;
    }
  }

  > div {
    padding: 0 0 16px 0;
  }
}